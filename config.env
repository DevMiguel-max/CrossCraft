# config.env — edite e rode ./mc restart
# Os valores do servidor (nome, jogadores, distância...) só são aplicados na CRIAÇÃO do server.properties.
# Depois disso, edite server/server.properties direto (ou apague server/.configured para reaplicar).

# --- EULA do Minecraft (OBRIGATÓRIO) ---
# Leia https://aka.ms/MinecraftEULA. Se concordar, troque para "true". O script não aceita por você.
EULA="false"

# --- Java (Paper) ---
PAPER_VERSION="26.3"         # precisa ser a versão Java que o Geyser suporta (hoje 26.3). "latest" pega a mais nova do Paper
PAPER_ALLOW_UNSTABLE="0"     # "1" aceita build não estável se a versão não tiver build STABLE
JAVA_PORT="25565"            # TCP: jogadores Java

# --- Bedrock (Geyser) ---
BEDROCK_PORT="19132"         # UDP: jogadores Bedrock
# "raknet" é o único modo que o túnel do playit aceita. Atenção: o Geyser marca o RakNet como removido no
# Minecraft Bedrock 26.60. "both" aceita RakNet e NetherNet, mas o NetherNet precisa de outra porta UDP e de signaling.
BEDROCK_TRANSPORT="raknet"
USE_FLOODGATE="1"            # "1": jogadores Bedrock entram sem ter conta Java (Xbox basta)
VIAVERSION="0"               # "1": instala o ViaVersion (deixa jogadores Java de versões diferentes entrarem)

# --- Recursos ---
MEMORY="4G"                # "auto" usa ~60% da RAM (entre 768M e 4G); ou fixe, ex: "2G"
JAVA_FLAGS="-XX:+UseG1GC"
# JAVA_URL=""                # opcional (só Linux): link de um .tar.gz do Java 25 se o GitHub do Temurin estiver bloqueado

# --- servidor (valores iniciais do server.properties) ---
SERVER_NAME="Crossplay Server"
MAX_PLAYERS="10"
VIEW_DISTANCE="8"            # celular ou sandbox pequeno: mantenha baixo (6 a 8)
SIMULATION_DISTANCE="6"
GAMEMODE="survival"
DIFFICULTY="normal"
ONLINE_MODE="true"           # "false" deixa Java sem conta oficial entrar (inseguro na internet)

# --- execução ---
AUTO_RESTART="1"             # reinicia se cair (para após 3 quedas em <30s)
BACKUP_KEEP="3"

# --- playit (acesso pela internet para TCP e UDP) ---
USE_PLAYIT="1"
PLAYIT_VERSION="v1.0.10"     # "latest" arrisca mudança de CLI
